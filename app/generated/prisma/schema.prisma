generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int               @id @default(autoincrement())
  status            String            @default("Active") @map("status")
  phone_number      String            @unique
  user_code         String?
  recovery_code     String?
  password          String
  fp_id             String
  ip                String
  balance           Decimal           @default(0) @db.Decimal(10, 2)
  turn_over         Decimal           @default(0) @db.Decimal(10, 2)
  invited_by        String?           @map("invite_code")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  game_transactions GameTransaction[]
  transactions      Transaction[]
  otp_records       OtpRecord[]
  vouchers          Voucher[]
}

model OtpRecord {
  id        Int      @id @default(autoincrement())
  phone     String
  user      User     @relation(fields: [phone], references: [phone_number])
  otp       String
  valid     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Transaction {
  id        Int               @id @default(autoincrement())
  amount    Decimal           @db.Decimal(10, 2)
  type      TransactionType
  trx_id    String?
  sign      String?
  status    TransactionStatus @default(pending)
  user_id   Int
  method    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [user_id], references: [id])
}

model GameTransaction {
  id        Int      @id @default(autoincrement())
  trans_id  String   @unique
  type      String
  amount    Decimal  @db.Decimal(10, 2)
  game_code String?
  user_id   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [user_id], references: [id])
}

model Message {
  id        Int      @id @default(autoincrement())
  sender    String
  receiver  String
  content   String?
  fileUrl   String?
  createdAt DateTime @default(now())
  seen      Boolean  @default(false)
}

enum TransactionStatus {
  pending
  completed
  cancelled
}

enum TransactionType {
  deposit
  withdraw
  bonus
  commission
  salary
}

model Voucher {
  id           Int       @id @default(autoincrement())
  code         String
  amount       Decimal   @db.Decimal(10, 2)
  collected    Boolean   @default(false)
  collected_at DateTime?
  message      String?
  collected_by Int?
  user         User?     @relation(fields: [collected_by], references: [id])
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
}

enum SlideImagePlacement {
  first_slide
  second_slide
  third_slide
}

enum DeviceType {
  desktop
  mobile
  tablet
}

enum SlideImagePage {
  home
  referral
  wallet
  promotions
  games
}

model SlideImage {
  id        Int                  @id @default(autoincrement())
  imageUrl  String
  page      SlideImagePage
  placement SlideImagePlacement?
  device    DeviceType?
  createdAt DateTime             @default(now())
}

// ==================== NEW SUB ADMIN MODELS ====================

// Admin Model (Super Admin)
model Admin {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(255)
  email     String      @unique @db.VarChar(255)
  password  String      @db.VarChar(255)
  role      String      @default("super_admin") @db.VarChar(50)
  status    AdminStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  lastLogin DateTime?   @map("last_login")

  // Relations
  subAdmins SubAdmin[] @relation("AdminCreatedSubAdmins")

  @@map("admins")
}

// Sub Admins Model
model SubAdmin {
  id        Int            @id @default(autoincrement())
  name      String         @db.VarChar(255)
  email     String         @unique @db.VarChar(255)
  password  String         @db.VarChar(255)
  role      String         @default("sub_admin") @db.VarChar(50)
  status    SubAdminStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  lastLogin DateTime?      @map("last_login")
  createdBy Int?           @map("created_by")

  // Relations
  createdByAdmin Admin?               @relation("AdminCreatedSubAdmins", fields: [createdBy], references: [id])
  permissions    SubAdminPermission[]

  @@map("sub_admins")
}

// Permissions Table
model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String? @db.Text

  // Relations
  rolePermissions     RolePermission[]
  subAdminPermissions SubAdminPermission[]

  @@map("permissions")
}

// Role Permissions Table (for different role types)
model RolePermission {
  id           Int     @id @default(autoincrement())
  roleId       Int     @map("role_id")
  permissionId Int     @map("permission_id")
  canView      Boolean @default(false) @map("can_view")
  canCreate    Boolean @default(false) @map("can_create")
  canEdit      Boolean @default(false) @map("can_edit")
  canDelete    Boolean @default(false) @map("can_delete")

  // Relations
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Sub Admin Individual Permissions
model SubAdminPermission {
  id           Int     @id @default(autoincrement())
  subAdminId   Int     @map("sub_admin_id")
  permissionId Int     @map("permission_id")
  canView      Boolean @default(false) @map("can_view")
  canCreate    Boolean @default(false) @map("can_create")
  canEdit      Boolean @default(false) @map("can_edit")
  canDelete    Boolean @default(false) @map("can_delete")

  // Relations
  subAdmin   SubAdmin   @relation(fields: [subAdminId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([subAdminId, permissionId])
  @@map("sub_admin_permissions")
}

// Enums
enum AdminStatus {
  active
  inactive
  suspended
}

enum SubAdminStatus {
  active
  inactive
  suspended
}
